# NexGen Council — Environment Configuration

# Application Port (Hardcoded to 3000 in cloud environment)
PORT=3000

# Admin Portal Credentials
# Configure the default Super Admin login credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nexgencouncil.org
ADMIN_PASSWORD=

# Database Configuration (Self-managed MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/nexgen_council
MONGODB_DB_NAME=nexgen_council

# Security
SESSION_SECRET=

# Gemini API Key (Optional AI features)
GEMINI_API_KEY=

# Application URL
APP_URL=
